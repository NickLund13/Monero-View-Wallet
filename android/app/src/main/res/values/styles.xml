<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- While the app starts, with Dark Mode off: the app's light background.
         Android 12 and later show the app icon on it. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
    <!-- Behind the Flutter UI once it is drawn. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
